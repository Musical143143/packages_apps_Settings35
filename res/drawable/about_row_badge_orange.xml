<?xml version="1.0" encoding="utf-8"?>
<!-- Orange badge with a white package icon, for the Build Package Type row. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#FFF5A524" />
        </shape>
    </item>
    <item
        android:width="14dp"
        android:height="14dp"
        android:gravity="center"
        android:drawable="@drawable/ic_about_package"
        android:tint="#FFFFFFFF" />
</layer-list>
