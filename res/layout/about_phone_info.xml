<!--
   Device hero card for the Android version screen. The card draws its own
   RGB-cycling gradient background (light and dark aware). It holds a larger
   wallpaper preview, the device name with an accent bar, and three spec pills
   with icon chips. Text colors come from theme attributes.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/superior_info"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp">

    <com.android.settings.deviceinfo.firmwareversion.AboutHeroCardLayout
        android:id="@+id/superior_info_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/phone_image"
                android:layout_width="120dp"
                android:layout_height="200dp"
                app:cardCornerRadius="28dp"
                app:cardElevation="0dp"
                app:strokeColor="?android:attr/textColorSecondary"
                app:strokeWidth="2dp">

                <org.lunaris.settings.utils.WallpaperView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:gravity="center"
                    android:elevation="0dp"
                    android:contentDescription="@null"
                    android:orientation="vertical" />

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="20dp">

                <TextView
                    android:id="@+id/device_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="@string/lunaris_device_title"
                    android:textAllCaps="true"
                    android:textSize="12sp"
                    android:letterSpacing="0.12"
                    android:textColor="?android:attr/textColorSecondary"
                    style="@style/TextAppearance.SuperiorInfoTitle" />

                <TextView
                    android:id="@+id/device_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/lunaris_device_message"
                    android:textSize="28sp"
                    android:lineSpacingMultiplier="0.95"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary" />

                <View
                    android:layout_width="56dp"
                    android:layout_height="5dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/about_phone_accent_bar" />
            </LinearLayout>
        </LinearLayout>

        <!-- Processor -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/about_phone_glass_tile"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/about_phone_chip_bg">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_about_bolt"
                    android:tint="#FF8B5CF6" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="14dp">

                <TextView
                    android:id="@+id/processor_code_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/lunaris_processor_code_title"
                    android:textAllCaps="true"
                    android:textSize="11sp"
                    android:letterSpacing="0.08"
                    android:textColor="?android:attr/textColorSecondary"
                    style="@style/TextAppearance.SuperiorInfoTitle" />

                <TextView
                    android:id="@+id/processor_code_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/lunaris_processor_code_message"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary" />
            </LinearLayout>
        </LinearLayout>

        <!-- Battery -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/about_phone_glass_tile"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/about_phone_chip_bg">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_about_battery"
                    android:tint="#FF8B5CF6" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="14dp">

                <TextView
                    android:id="@+id/battery_type_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/lunaris_battery_type_title"
                    android:textAllCaps="true"
                    android:textSize="11sp"
                    android:letterSpacing="0.08"
                    android:textColor="?android:attr/textColorSecondary"
                    style="@style/TextAppearance.SuperiorInfoTitle" />

                <TextView
                    android:id="@+id/battery_type_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/lunaris_battery_type_message"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary" />
            </LinearLayout>
        </LinearLayout>

        <!-- Screen -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/about_phone_glass_tile"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/about_phone_chip_bg">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_about_display"
                    android:tint="#FF8B5CF6" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="14dp">

                <TextView
                    android:id="@+id/screen_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/lunaris_screen_title"
                    android:textAllCaps="true"
                    android:textSize="11sp"
                    android:letterSpacing="0.08"
                    android:textColor="?android:attr/textColorSecondary"
                    style="@style/TextAppearance.SuperiorInfoTitle" />

                <TextView
                    android:id="@+id/screen_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/lunaris_screen_message"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary" />
            </LinearLayout>
        </LinearLayout>

    </com.android.settings.deviceinfo.firmwareversion.AboutHeroCardLayout>
</LinearLayout>
