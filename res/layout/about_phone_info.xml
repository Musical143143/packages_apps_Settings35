<!--
   Device hero card for the Android version screen. A gradient card holds the
   wallpaper preview, the device name with an accent bar, and three spec rows
   with icon chips. Backgrounds come from drawables (light and night variants)
   and text colors come from theme attributes, so the card follows light and
   dark mode.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/superior_info"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp">

    <LinearLayout
        android:id="@+id/superior_info_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/about_phone_hero_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="20dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/phone_image"
            android:layout_width="104dp"
            android:layout_height="184dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeColor="?android:attr/textColorSecondary"
            app:strokeWidth="2dp">

            <org.lunaris.settings.utils.WallpaperView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:gravity="center"
                android:elevation="0dp"
                android:contentDescription="@null"
                android:orientation="vertical" />

        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="20dp">

            <TextView
                android:id="@+id/device_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:text="@string/lunaris_device_title"
                android:textSize="11sp"
                android:textColor="?android:attr/textColorSecondary"
                style="@style/TextAppearance.SuperiorInfoTitle" />

            <TextView
                android:id="@+id/device_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/lunaris_device_message"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary" />

            <View
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/about_phone_accent_bar" />

            <!-- Processor -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/about_phone_chip_bg">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_about_cpu"
                        android:tint="#FF8B5CF6" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="12dp">

                    <TextView
                        android:id="@+id/processor_code_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/lunaris_processor_code_title"
                        android:textSize="12sp"
                        android:textColor="?android:attr/textColorSecondary"
                        style="@style/TextAppearance.SuperiorInfoTitle" />

                    <TextView
                        android:id="@+id/processor_code_message"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/lunaris_processor_code_message"
                        android:textSize="15sp"
                        android:textColor="?android:attr/textColorPrimary" />
                </LinearLayout>
            </LinearLayout>

            <!-- Battery -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/about_phone_chip_bg">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_battery_full"
                        android:tint="#FF8B5CF6" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="12dp">

                    <TextView
                        android:id="@+id/battery_type_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/lunaris_battery_type_title"
                        android:textSize="12sp"
                        android:textColor="?android:attr/textColorSecondary"
                        style="@style/TextAppearance.SuperiorInfoTitle" />

                    <TextView
                        android:id="@+id/battery_type_message"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/lunaris_battery_type_message"
                        android:textSize="15sp"
                        android:textColor="?android:attr/textColorPrimary" />
                </LinearLayout>
            </LinearLayout>

            <!-- Screen -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/about_phone_chip_bg">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_about_screen"
                        android:tint="#FF8B5CF6" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="12dp">

                    <TextView
                        android:id="@+id/screen_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/lunaris_screen_title"
                        android:textSize="12sp"
                        android:textColor="?android:attr/textColorSecondary"
                        style="@style/TextAppearance.SuperiorInfoTitle" />

                    <TextView
                        android:id="@+id/screen_message"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/lunaris_screen_message"
                        android:textSize="15sp"
                        android:textColor="?android:attr/textColorPrimary" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</LinearLayout>
